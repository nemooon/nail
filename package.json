{
  "name": "nail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node src/local/index.ts",
    "dev:ui": "vite --mode standalone --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build --mode standalone",
    "build:live": "cf build && tsc --noEmit && tsc -p tsconfig.worker.json",
    "deploy:live": "npm run build:live && cf deploy --prebuilt",
    "auth": "node scripts/auth.ts",
    "sync": "node scripts/sync.ts",
    "test": "node --test src/client/*.test.ts src/gmail/*.test.ts src/local/*.test.ts src/worker/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@mantine/core": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "@tabler/icons-react": "^3.34.0",
    "hono": "^4.13.12",
    "postcss": "^8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-ad79608dd",
    "@hono/cli": "^0.2.0-next.9",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^5.0.0",
    "cf": "^1.0.0-beta.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
